# Recommended for the free MVP setup (GROQ_API_KEY selects Groq defaults).
GROQ_API_KEY=
# Optional common overrides:
AI_BASE_URL=
AI_MODEL=

# Optional legacy xAI/Grok configuration (used when GROQ_API_KEY is absent).
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini

# Set a long random value in deployment; local demo uses a process-local key.
SESSION_SECRET=
